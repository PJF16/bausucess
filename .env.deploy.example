# Produktions-Konfiguration für docker-compose.prod.yml
# Kopieren nach .env.deploy und Werte setzen:
#   cp .env.deploy.example .env.deploy
# AUTH_SECRET erzeugen mit:  openssl rand -base64 32

POSTGRES_USER=bausuccess
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bausuccess

AUTH_SECRET=CHANGE_ME

# Öffentliche Basis-URL der App (Pflicht, nicht leer lassen):
# hinter Reverse-Proxy/Domain z. B. https://bausuccess.example.at
AUTH_URL=http://localhost:3000

# Port, auf dem die App am Host erreichbar ist
APP_PORT=3000
